open Lean Meta Elab Command
private partial def indexedNativeRefs (e : Expr) (seen : NameSet := {}) : MetaM (Array Name) := do
  let mut found : Array Name := #[]
  let mut seen := seen
  for n in e.getUsedConstants do
    if seen.contains n then continue
    seen := seen.insert n
    let s := n.toString
    if s.startsWith "Rocq." || s.startsWith "RocqPending." || s.startsWith "Rocq2Lean." then
      found := found.push n
    else if s.startsWith "NativeBridge." then
      let ci ← getConstInfo n
      let body? := match ci with
        | .defnInfo v => some v.value
        | .thmInfo v => some v.value
        | .opaqueInfo v => some v.value
        | _ => none
      if let some body := body? then
        found := found ++ (← indexedNativeRefs body seen)
  return found


open Lean in
run_cmd Lean.Elab.Command.liftTermElabM do
  for name in ["NativeBridge.Incremental.HexadecimalRepresentation.HexadecimalNative", "NativeBridge.Incremental.HexadecimalRepresentation.digitInduction", "NativeBridge.Incremental.HexadecimalRepresentation.digitsRec", "NativeBridge.Incremental.HexadecimalRepresentation.dropHead", "NativeBridge.Incremental.HexadecimalRepresentation.dropHeadInt", "NativeBridge.Incremental.HexadecimalRepresentation.dropTail", "NativeBridge.Incremental.HexadecimalRepresentation.dropTailInt", "NativeBridge.Incremental.HexadecimalRepresentation.equalityComplete", "NativeBridge.Incremental.HexadecimalRepresentation.equalitySound", "NativeBridge.Incremental.HexadecimalRepresentation.hexadecimalEqual", "NativeBridge.Incremental.HexadecimalRepresentation.littleDouble", "NativeBridge.Incremental.HexadecimalRepresentation.nativeDecision", "NativeBridge.Incremental.HexadecimalRepresentation.trimTail", "NativeBridge.Incremental.HexadecimalRepresentation.trimTailInt"] do
    let n := name.toName
    let ci ← getConstInfo n
    let some body := ci.value? | throwError "Expected native definition"
    let refs := (← indexedNativeRefs body) ++ (← indexedNativeRefs ci.type)
    unless refs.isEmpty do throwError "Residual source references: {refs}"
    let expression ← Lean.Meta.ppExpr body
    logInfo ("NATIVE_TARGET " ++ (Json.compress (Json.mkObj [
      ("name", .str n.toString), ("native_expression", .str expression.pretty),
      ("remaining_source_symbols", .arr #[])])))
