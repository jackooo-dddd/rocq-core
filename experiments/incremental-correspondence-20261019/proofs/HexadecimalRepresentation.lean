def digitInduction : Prop :=
  ∀ P : List (Fin 16) → Prop, P [] → (∀ d ds, P ds → P (d::ds)) → ∀ ds, P ds
theorem digit_ind_native : digitInduction := fun _P nil cons => List.rec nil cons
theorem uint_ind_proof : Rocq.Corelib.Init.Hexadecimal.uint_ind.statement := by
  intro P nil h0 h1 h2 h3 h4 h5 h6 h7 h8 h9 ha hb hc hd he hf d
  induction d with
  | Nil => exact nil
  | D0 d ih => exact h0 d ih
  | D1 d ih => exact h1 d ih
  | D2 d ih => exact h2 d ih
  | D3 d ih => exact h3 d ih
  | D4 d ih => exact h4 d ih
  | D5 d ih => exact h5 d ih
  | D6 d ih => exact h6 d ih
  | D7 d ih => exact h7 d ih
  | D8 d ih => exact h8 d ih
  | D9 d ih => exact h9 d ih
  | Da d ih => exact ha d ih
  | Db d ih => exact hb d ih
  | Dc d ih => exact hc d ih
  | Dd d ih => exact hd d ih
  | De d ih => exact he d ih
  | Df d ih => exact hf d ih

theorem uint_sind_proof : Rocq.Corelib.Init.Hexadecimal.uint_sind.statement := uint_ind_proof
theorem uint_ind_correspondence : Rocq.Corelib.Init.Hexadecimal.uint_ind.statement ↔ digitInduction :=
  ⟨fun _ => digit_ind_native,fun _ => uint_ind_proof⟩
theorem uint_sind_correspondence : Rocq.Corelib.Init.Hexadecimal.uint_sind.statement ↔ digitInduction :=
  ⟨fun _ => digit_ind_native,fun _ => uint_sind_proof⟩

theorem digitBool_injective (a b : Rocq.Corelib.Init.Datatypes.bool)
    (h : digitBoolTo a = digitBoolTo b) : a = b := by
  cases a <;> cases b <;> simp_all [digitBoolTo]

def equalitySound : Prop := ∀ x y : HexadecimalNative, hexadecimalEqual x y = true → x = y
def equalityComplete : Prop := ∀ x y : HexadecimalNative, x = y → hexadecimalEqual x y = true
theorem equality_sound_native : equalitySound := by intro x y h; simpa [hexadecimalEqual] using h
theorem equality_complete_native : equalityComplete := by intro x y h; simp [hexadecimalEqual,h]
theorem hexadecimal_dec_bl_proof : Rocq.Corelib.Init.Hexadecimal.internal_hexadecimal_dec_bl.statement := by
  intro x y h
  have hh := congrArg digitBoolTo (eqTo h)
  rw [hexadecimal_beq_agrees] at hh
  exact eqOf (hexadecimalIso.injective (equality_sound_native _ _ hh))
theorem hexadecimal_dec_lb_proof : Rocq.Corelib.Init.Hexadecimal.internal_hexadecimal_dec_lb.statement := by
  intro x y h
  have he := eqTo h
  subst y
  apply eqOf
  apply digitBool_injective
  rw [hexadecimal_beq_agrees]
  exact equality_complete_native _ _ rfl
theorem hexadecimal_dec_bl_correspondence :
    Rocq.Corelib.Init.Hexadecimal.internal_hexadecimal_dec_bl.statement ↔ equalitySound :=
  ⟨fun _ => equality_sound_native,fun _ => hexadecimal_dec_bl_proof⟩
theorem hexadecimal_dec_lb_correspondence :
    Rocq.Corelib.Init.Hexadecimal.internal_hexadecimal_dec_lb.statement ↔ equalityComplete :=
  ⟨fun _ => equality_complete_native,fun _ => hexadecimal_dec_lb_proof⟩

def nativeDecision {A : Type} [DecidableEq A] (x y : A) : Decidable (x = y) := inferInstance

def eqDecisionTo {A B : Type} (e : Iso A B) (x y : A)
    (d : Rocq.Corelib.Init.Specif.sumbool (ME A x y) (Rocq.Corelib.Init.Logic.not (ME A x y))) :
    Decidable (e.to x = e.to y) :=
  match d with
  | .left _ _ h => .isTrue (congrArg e.to (eqTo h))
  | .right _ _ h => .isFalse (fun he => by cases h (eqOf (e.injective he)))


