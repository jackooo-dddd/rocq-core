NATIVE_TARGET {"name":"NativeBridge.Incremental.PrimFloatSqrt.squareRoot","native_expression":"fun x =>\n  match x with\n  | none => none\n  | some (Sum.inr s) => if s = true then none else x\n  | some (Sum.inl (s, fst, snd)) =>\n    if NativeBridge.Incremental.PrimFloatRepresentation.isZero x = true then x\n    else\n      if s = true then none\n      else\n        have k :=\n          ↑(NativeBridge.Incremental.PrimFloatRepresentation.mantissa x).log2 +\n            NativeBridge.Incremental.PrimFloatRepresentation.exponent x;\n        have q := max (-1074) (k / 2 - 52);\n        have shift := NativeBridge.Incremental.PrimFloatRepresentation.exponent x - 2 * q;\n        have n :=\n          if shift < 0 then NativeBridge.Incremental.PrimFloatRepresentation.mantissa x\n          else NativeBridge.Incremental.PrimFloatRepresentation.mantissa x * 2 ^ shift.toNat;\n        have d := if shift < 0 then 2 ^ (-shift).toNat else 1;\n        have m := (n / d).sqrt;\n        have mid := d * (2 * m + 1) ^ 2;\n        have m := if (decide (4 * n > mid) || 4 * n == mid && m % 2 == 1) = true then m + 1 else m;\n        NativeBridge.Incremental.PrimFloatArithmetic.pack false m q","remaining_source_symbols":[]}
