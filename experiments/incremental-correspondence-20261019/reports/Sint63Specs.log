NATIVE_TARGET {"name":"BitVec.sdiv","native_expression":"fun {n} x y =>\n  match x.msb, y.msb with\n  | false, false => x.udiv y\n  | false, true => (x.udiv y.neg).neg\n  | true, false => (x.neg.udiv y).neg\n  | true, true => x.neg.udiv y.neg","remaining_source_symbols":[]}
NATIVE_TARGET {"name":"BitVec.srem","native_expression":"fun {n} x y =>\n  match x.msb, y.msb with\n  | false, false => x.umod y\n  | false, true => x.umod y.neg\n  | true, false => (x.neg.umod y).neg\n  | true, true => (x.neg.umod y.neg).neg","remaining_source_symbols":[]}
NATIVE_TARGET {"name":"NativeBridge.Incremental.Sint63Specs.arithmeticShift","native_expression":"fun x p => if BitVec.toInt p < 0 then 0 else BitVec.sshiftRight x (BitVec.toNat p)","remaining_source_symbols":[]}
NATIVE_TARGET {"name":"NativeBridge.Incremental.Sint63Specs.arithmeticShiftSpec","native_expression":"∀ (x p : NativeBridge.Incremental.Sint63UnsignedSupport.Word),\n  BitVec.toInt (NativeBridge.Incremental.Sint63Specs.arithmeticShift x p) =\n    (BitVec.toInt x).fdiv (NativeBridge.Incremental.BinaryPower.zPowNative 2 (BitVec.toInt p))","remaining_source_symbols":[]}
NATIVE_TARGET {"name":"NativeBridge.Incremental.Sint63Specs.signedDivisionSpec","native_expression":"∀ (x y : NativeBridge.Incremental.Sint63UnsignedSupport.Word),\n  BitVec.toInt x ≠ -2 ^ 62 ∨ BitVec.toInt y ≠ -1 → (BitVec.sdiv x y).toInt = (BitVec.toInt x).tdiv (BitVec.toInt y)","remaining_source_symbols":[]}
NATIVE_TARGET {"name":"NativeBridge.Incremental.Sint63Specs.signedRemainderSpec","native_expression":"∀ (x y : NativeBridge.Incremental.Sint63UnsignedSupport.Word),\n  (BitVec.srem x y).toInt = (BitVec.toInt x).tmod (BitVec.toInt y)","remaining_source_symbols":[]}
