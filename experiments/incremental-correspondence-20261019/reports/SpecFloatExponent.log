NATIVE_TARGET {"name":"NativeBridge.Incremental.SpecFloatExponent.unitInLastPlace","native_expression":"fun prec emax x =>\n  NativeBridge.Incremental.SpecFloatNormalize.scale prec emax\n    (NativeBridge.Incremental.SpecFloatNormalize.one prec emax)\n    (NativeBridge.Incremental.SpecFloatRounding.exponent prec emax\n      (NativeBridge.Incremental.SpecFloatExponent.fraction prec emax x).snd)","remaining_source_symbols":[]}
