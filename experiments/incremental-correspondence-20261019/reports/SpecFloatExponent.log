NATIVE_TARGET {"name":"NativeBridge.Incremental.SpecFloatExponent.fraction","native_expression":"fun prec emax x =>\n  match x with\n  | NativeBridge.Incremental.SpecFloatRepresentation.SpecValue.finite s m e =>\n    have digits := ↑(NativeBridge.Incremental.SpecFloatRounding.positiveDigits m.val);\n    if prec ≤ digits then (NativeBridge.Incremental.SpecFloatRepresentation.SpecValue.finite s m (-prec), e + prec)\n    else\n      have d := prec - digits;\n      (NativeBridge.Incremental.SpecFloatRepresentation.SpecValue.finite s\n          (NativeBridge.Incremental.SpecFloatExponent.grow m (max 1 d.toNat)) (-prec),\n        e + prec - d)\n  | x_1 => (x, -2 * emax - prec)","remaining_source_symbols":[]}
