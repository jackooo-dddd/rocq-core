NATIVE_TARGET {"name":"NativeBridge.Incremental.SpecFloatNormalize.classify","native_expression":"fun prec x =>\n  match x with\n  | NativeBridge.Incremental.SpecFloatRepresentation.SpecValue.zero s => if s = true then 5 else 4\n  | NativeBridge.Incremental.SpecFloatRepresentation.SpecValue.infinity s => if s = true then 7 else 6\n  | NativeBridge.Incremental.SpecFloatRepresentation.SpecValue.nan => 8\n  | NativeBridge.Incremental.SpecFloatRepresentation.SpecValue.finite s m a =>\n    if s = true then if ↑(NativeBridge.Incremental.SpecFloatRounding.positiveDigits m.val) = prec then 1 else 3\n    else if ↑(NativeBridge.Incremental.SpecFloatRounding.positiveDigits m.val) = prec then 0 else 2","remaining_source_symbols":[]}
NATIVE_TARGET {"name":"NativeBridge.Incremental.SpecFloatNormalize.normalMantissa","native_expression":"fun prec x =>\n  match x with\n  | NativeBridge.Incremental.SpecFloatRepresentation.SpecValue.finite a m e => if e = -prec then m.val else 0\n  | x => 0","remaining_source_symbols":[]}
NATIVE_TARGET {"name":"NativeBridge.Incremental.SpecFloatNormalize.normalize","native_expression":"fun prec emax m e zeroSign =>\n  if m = 0 then NativeBridge.Incremental.SpecFloatRepresentation.SpecValue.zero zeroSign\n  else NativeBridge.Incremental.SpecFloatNormalize.roundPositive prec emax (decide (m < 0)) m.natAbs e","remaining_source_symbols":[]}
NATIVE_TARGET {"name":"NativeBridge.Incremental.SpecFloatNormalize.one","native_expression":"fun prec emax => NativeBridge.Incremental.SpecFloatNormalize.roundPositive prec emax false 1 0","remaining_source_symbols":[]}
NATIVE_TARGET {"name":"NativeBridge.Incremental.SpecFloatNormalize.roundAux","native_expression":"fun prec emax sign m e l =>\n  have first := NativeBridge.Incremental.SpecFloatShift.shiftToExponent prec emax m e l;\n  have next :=\n    NativeBridge.Incremental.SpecFloatRounding.nearestEven\n      (NativeBridge.Incremental.SpecFloatRepresentation.mantissa first.fst)\n      (NativeBridge.Incremental.SpecFloatRepresentation.fromShift first.fst);\n  have second := NativeBridge.Incremental.SpecFloatShift.shiftToExponent prec emax next first.snd none;\n  NativeBridge.Incremental.SpecFloatNormalize.finish sign\n    (NativeBridge.Incremental.SpecFloatRepresentation.mantissa second.fst) second.snd (emax - prec)","remaining_source_symbols":[]}
NATIVE_TARGET {"name":"NativeBridge.Incremental.SpecFloatNormalize.roundPositive","native_expression":"fun prec emax sign m e =>\n  have aligned :=\n    NativeBridge.Incremental.SpecFloatShift.alignment m e\n      (NativeBridge.Incremental.SpecFloatRounding.exponent prec emax\n        (↑(NativeBridge.Incremental.SpecFloatRounding.positiveDigits m) + e));\n  NativeBridge.Incremental.SpecFloatNormalize.roundAux prec emax sign (↑aligned.fst) aligned.snd none","remaining_source_symbols":[]}
NATIVE_TARGET {"name":"NativeBridge.Incremental.SpecFloatNormalize.scale","native_expression":"fun prec emax x n =>\n  match x with\n  | NativeBridge.Incremental.SpecFloatRepresentation.SpecValue.finite sign m e =>\n    NativeBridge.Incremental.SpecFloatNormalize.roundPositive prec emax sign m.val (e + n)\n  | x_1 => x","remaining_source_symbols":[]}
